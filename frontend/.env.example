# Copy this file to frontend/.env.local and fill in real values. Never commit .env.local.
# Variables starting with NEXT_PUBLIC_ are visible in the browser — never put secrets in them.

# --- Django API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Google Maps (restrict this key to your domains in Google Cloud) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
# Map ID controls the custom pin styling (required for AdvancedMarker).
# Create one in Google Cloud Console > Maps > Map IDs. Falls back to
# Google's own "DEMO_MAP_ID" in development if unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-google-maps-map-id

# --- Cloudflare Turnstile (test site key that always passes) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Shared secret for Django -> Next.js page refresh (must match backend) ---
REVALIDATE_SECRET=change-me-shared-secret
