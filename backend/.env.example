# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# RENDER_EXTERNAL_HOSTNAME is set automatically by Render in production —
# don't set it yourself; it's appended to ALLOWED_HOSTS in code. Leave unset
# locally.

# --- Database (Render's managed Postgres gives you this URL in production) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forksandfarms

# --- CORS: which frontends may call the API (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Regex matching this project's Vercel preview URLs (one per branch/PR), e.g.
# ^https://forksandfarms-frontend-[a-z0-9-]+-your-team\.vercel\.app$
# Leave unset locally. Set once the Vercel project exists — see the deploy
# walkthrough for the exact pattern Vercel assigns.
CORS_ALLOWED_ORIGIN_REGEX_VERCEL=

# --- CSRF: trusted origins for cross-origin POSTs to /admin (comma-separated).
# Needed in production for the onrender.com service URL and the Vercel
# production domain. Leave unset locally (DEBUG mode skips this entirely).
CSRF_TRUSTED_ORIGINS=

# --- Reverse proxy depth, for correct client-IP detection (rate limiting,
# PartnerApplication.source_ip). Render sits one proxy in front of the
# app; leave at 1 there. Set to 0 only if there is truly no reverse proxy.
NUM_PROXIES=1

# --- Cloudinary (venue photos) ---
# Required when DJANGO_DEBUG=False — Render's disk is not persistent across
# deploys, so local-disk storage (the dev-only fallback) would lose every
# uploaded photo on the next deploy. Settings.py raises at startup if this
# is empty outside DEBUG.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Resend (emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
FNF_NOTIFY_EMAIL=hello@yourdomain.com
FNF_FROM_EMAIL=Forks And Farms <hello@yourdomain.com>

# --- Cloudflare Turnstile (spam check on partner form) ---
# Cloudflare test secret that always passes; swap for real key in production.
# Outside DEBUG, an empty secret here makes applications fail closed
# (rejected, not silently accepted) rather than skip verification.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Tell Next.js to refresh pages when venues change in admin ---
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-secret


NEXT_PUBLIC_TURNSTILE_SITE_KEY=

TURNSTILE_SECRET_KEY=