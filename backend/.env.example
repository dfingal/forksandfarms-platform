# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Railway gives you this URL in production) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forksandfarms

# --- CORS: which frontends may call the API (comma-separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Reverse proxy depth, for correct client-IP detection (rate limiting,
# PartnerApplication.source_ip). Railway sits one proxy in front of the
# app; leave at 1 there. Set to 0 only if there is truly no reverse proxy.
NUM_PROXIES=1

# --- Cloudinary (venue photos) ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Resend (emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
FNF_NOTIFY_EMAIL=hello@yourdomain.com
FNF_FROM_EMAIL=Forks And Farms <hello@yourdomain.com>

# --- Cloudflare Turnstile (spam check on partner form) ---
# Cloudflare test secret that always passes; swap for real key in production
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Tell Next.js to refresh pages when venues change in admin ---
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-secret
